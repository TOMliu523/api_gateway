submodule network {
    belongs-to v1 {
        prefix "v1";
    }

    import ietf-inet-types {
        prefix "inet";
    }

    import types {
        prefix "tps"
    }

    container ip4 {
        list entries {
            key "interface-name addr mask";
            leaf interface-name {
                mandatory true;
                typedef tps:interface-name;
            }

            leaf addr {
                mandatory true;
                type inet:ipv4-address;
            }

            leaf mask {
                mandatory true;
                type uint8 {
                    range "0 .. 32";
                }
                description "A mask value from 0 to 32 inclusive.";
            }

            leaf type {
                mandatory true;
                type enumeration {
                    enum IP_MASTER {
                        value 0;
                    }
                    enum IP_SECONDARY {
                        value 1;
                    }
                }
            }
        }
    }

    container ip6 {
        list entries {
            key "interface-name addr mask";
            leaf interface-name {
                mandatory true;
                typedef tys:interface-name;
            }

            leaf addr {
                mandatory true;
                type inet:ipv6-address;
            }

            leaf mask {
                mandatory true;
                type uint8 {
                    range "0 .. 128";
                }
                description "A mask value from 0 to 128 inclusive.";
            }

            leaf type {
                mandatory true;
                type enumeration {
                    enum IP_MASTER {
                        value 0;
                    }
                    enum IP_SECONDARY {
                        value 1;
                    }
                }
            }
        }
    }

    container route4 {
        list entries {
            key "net mask";

            leaf net {
                mandatory true;
                type inet:ipv4-address;
            }

            leaf mask {
                mandatory true;
                type uint8 {
                    range "0 .. 32";
                }
                description "A mask value from 0 to 32 inclusive.";
            }

            leaf nexthop {
                type inet:ipv4-address;
            }

            leaf interface {
                type tys:interface-name;
            }
        }
    }

    container route6 {
        list entries {
            key "net mask";

            leaf net {
                mandatory true;
                type inet:ipv6-address;
            }

            leaf mask {
                mandatory true;
                type uint8 {
                    range "0 .. 128";
                }
                description "A mask value from 0 to 128 inclusive.";
            }

            leaf nexthop {
                type inet:ipv6-address;
            }

            leaf interface {
                type tys:interface-name
            }
        }
    }
}
