module v1 {
  yang-version 1.1;
  namespace "urn:example:v1";
  prefix v1;

  include boot;

  container dynamic {
    leaf log-level {
      type enumeration {
        enum debug;
        enum info;
        enum warn;
        enum error;
      }
      default info;
      description "支持运行期间修改。";
    }
  }
}
